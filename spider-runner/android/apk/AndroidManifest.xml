<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fnmedia.catvodbridge"
    android:versionCode="1" android:versionName="1.0">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
    <!-- usesCleartextTraffic：targetSdk=30 时 Android 默认禁止明文 HTTP，
         而 spider jar 内部要访问 127.0.0.1 的本地代理与部分 http 站点，
         不放开会直接抛 UnknownServiceException: CLEARTEXT ... not permitted
         （2026-11-13 实测日志确认）。bridge 只在本机 redroid 内运行。 -->
    <application android:label="CatvodBridge" android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:name="com.fnmedia.bridge.HostApp">
        <activity android:name="com.fnmedia.bridge.BootActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name="com.fnmedia.bridge.BridgeService" android:exported="true" android:foregroundServiceType="dataSync">
            <intent-filter><action android:name="com.fnmedia.bridge.START"/></intent-filter>
        </service>
    </application>
</manifest>
